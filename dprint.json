{
  "lineWidth": 120,
  "newLineKind": "lf",
  "markdown": {
    "textWrap": "never",
    "unorderedListKind": "dashes",
    "emphasisKind": "underscores",
    "strongKind": "asterisks",
    "headingKind": "atx"
  },
  "includes": ["**/*.md"],
  "excludes": ["**/node_modules", ".local", ".live-test"],
  "plugins": ["https://plugins.dprint.dev/markdown-0.21.1.wasm"]
}
